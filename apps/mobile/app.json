{
  "expo": {
    "name": "Gopur",
    "slug": "gopur",
    "scheme": "gopur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#304385"
    },
    "android": {
      "package": "run.pur.go",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#304385"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d01f2ff4-9140-4956-b21d-bb7dba703ab1"
      }
    },
    "owner": "nsf77s-team"
  }
}
