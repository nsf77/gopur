{
  "name": "mobile",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "dev": "bun run paraglide && expo start",
    "android": "bun run paraglide && expo start --android",
    "web": "bun run paraglide && expo start --web",
    "export:web": "bun run paraglide && EXPO_OS=web EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform web --output-dir dist",
    "build:web": "bun run export:web",
    "typecheck": "bun run paraglide && tsc --noEmit",
    "build": "bun run export:web",
    "eas-build-post-install": "node ./scripts/eas-build-post-install.cjs",
    "eas:update:preview": "node ./scripts/eas-update-preview.cjs"
  },
  "dependencies": {
    "@better-auth/expo": "^1.4.0",
    "@expo/metro-runtime": "~58.0.15",
    "@gopur/shared": "workspace:*",
    "@inlang/paraglide-js": "^2.13.0",
    "@mobily/ts-belt": "^3.13.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.0",
    "api": "workspace:*",
    "better-auth": "^1.4.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.28",
    "expo-server": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "gluestack-ui": "^3.0.0",
    "hono": "^4.10.0",
    "nativewind": "5.0.0-rc.0",
    "phosphor-react-native": "^3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "valibot": "^1.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260421.1",
    "@types/react": "^19.2.0",
    "babel-preset-expo": "~58.0.22",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.0"
  }
}
