{
  "name": "api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "import": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "bun run --cwd ../mobile export:web && rm -rf public && mkdir -p public && cp -r ../mobile/dist/. public/",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "bun run build:web && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@better-auth/expo": "^1.4.0",
    "@hono/arktype-validator": "^2.0.1",
    "@mobily/ts-belt": "^3.13.1",
    "arktype": "^2.2.8",
    "better-auth": "^1.4.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260421.1",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
