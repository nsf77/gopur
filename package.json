{
  "name": "gopur",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "app",
    "api"
  ],
  "overrides": {
    "solid-js": "2.0.0-rc.14",
    "@solidjs/web": "2.0.0-rc.14"
  },
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "dev:api": "bun run --filter api dev",
    "dev:app": "bun run --filter app dev",
    "deploy:api": "bun run --filter api deploy",
    "deploy:app": "bun run --filter app deploy"
  }
}
