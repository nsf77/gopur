{
  "name": "gopur",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "turbo typecheck",
    "dev": "turbo dev --filter=api --filter=mobile",
    "dev:api": "turbo dev --filter=api",
    "dev:mobile": "turbo dev --filter=mobile",
    "build": "turbo build --filter=api",
    "deploy": "turbo deploy --filter=api",
    "test": "turbo test --filter=api --filter=@gopur/shared"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
