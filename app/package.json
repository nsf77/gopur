{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "build": "bun run paraglide && vite build",
    "typecheck": "bun run paraglide && tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@inlang/paraglide-js": "^2.13.0",
    "@mobily/ts-belt": "^3.13.1",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.132.0",
    "api": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "hono": "^4.10.0",
    "lucide-react": "^0.577.0",
    "nuqs": "^2.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "valibot": "^1.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxc-transform-react": "^0.152.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
